<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="target-azure-claude">
  <Description>Azure AI Foundry Target for Anthropic Claude (claude-haiku-4-5, claude-haiku-5-5, claude-sonnet-4-6)</Description>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>JS-TransformToAnthropic</Name>
      </Step>
      <Step>
        <Name>AM-SetAzureClaudeHeaders</Name>
      </Step>
    </Request>
    <Response>
      <Step>
        <Name>JS-TransformFromAnthropic</Name>
      </Step>
    </Response>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows/>
  <HTTPTargetConnection>
    <Properties>
      <Property name="connect.timeout.millis">60000</Property>
      <Property name="io.timeout.millis">120000</Property>
    </Properties>
    <URL>https://azure-ai-foundry.services.ai.azure.com</URL>
  </HTTPTargetConnection>
</TargetEndpoint>

