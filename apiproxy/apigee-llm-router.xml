  <Description>LiteLLM-compatible Apigee proxy supporting Claude (claude-haiku-4-5, claude-haiku-5-5, claude-sonnet-4-6 across AWS Bedrock, Azure AI Foundry, and GCP Vertex AI), OpenAI, Google Gemini, Qwen, and GLM models.</Description>
  <DisplayName>Apigee LLM Router</DisplayName>
  <LastModifiedAt>1728820000000</LastModifiedAt>
  <LastModifiedBy>apigee-admin</LastModifiedBy>
  <ManifestVersion majorVersion="4" minorVersion="0"/>
  <Policies>
    <Policy>AM-RemoveClientAuth</Policy>
    <Policy>AM-SetAnthropicHeaders</Policy>
    <Policy>AM-SetAPIKeyVariable</Policy>
    <Policy>AM-SetAWSClaudeHeaders</Policy>
    <Policy>AM-SetAzureClaudeHeaders</Policy>
    <Policy>AM-SetGCPClaudeHeaders</Policy>
    <Policy>AM-SetGeminiHeaders</Policy>
    <Policy>AM-SetGLMHeaders</Policy>
    <Policy>AM-SetOpenAIHeaders</Policy>
    <Policy>AM-SetQwenHeaders</Policy>
    <Policy>AM-SetResponseHeaders</Policy>
    <Policy>CORS-Headers</Policy>
    <Policy>DC-ModelAnalytics</Policy>
